// 셀러 브릭스 - Prisma 스키마
// provider 는 postgresql. docker-compose 의 Postgres 와 연결됩니다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Enums =====================
enum Role {
  SUPER_ADMIN
  MANAGER // 창고 운영 매니저 (본사 직원 · 담당 창고만 운영)
  FACILITY_ADMIN // (사용 안 함) 예전 창고(스튜디오) 관리자 계정 — 2026-11-14부터 가입 · 로그인 불가, 옛 기록 호환용
  BRAND_ADMIN
  SELLER
  BUYER
}

enum FacilityType {
  WAREHOUSE // 창고
  STUDIO // 스튜디오
  SHOWROOM // 쇼룸
}

// 창고(스튜디오) 운영 형태 — 외부 업체가 가입해서 여는 창고는 없다. 본사 직영 또는 긴밀하게 연동된 제휴 창고만 운영한다.
enum FacilityOperation {
  DIRECT // 직영: 판매 몫은 본사 수입 (지급 없음)
  PARTNER // 제휴: 판매 몫을 등록된 계좌로 지급
}

enum FacilityStatus {
  PENDING // 비공개(준비 중) — 셀러에게 보이지 않음
  APPROVED // 공개 (예약 가능)
  SUSPENDED // 운영 정지
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW // 노쇼 (승인된 예약에 나타나지 않음)
}

enum CommissionType {
  PERCENT
  FIXED
}

enum ProductSource {
  CATALOG // 창고(스튜디오)에 정식 등록된 상품
  AD_HOC // 방송 중 임시 추가
  TEMP_PRODUCT // 임시 상품(정식 전환 전)
}

enum LiveStatus {
  DRAFT
  READY
  LIVE
  ENDED
  CANCELLED
}

enum SnsChannelType {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  ETC
}

enum OrderStatus {
  ORDER_CREATED
  PAYMENT_PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  READY
  IN_PROGRESS
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD // 신용카드
  EASY_PAY // 간편결제
  BANK_TRANSFER // 간편 계좌이체
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  PAID
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ===================== Core: Users =====================
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              Role      @default(SELLER)
  isActive          Boolean   @default(true)
  profileImageIndex Int? // 1-30 동물 프로필 번호 (null이면 계정 기준 기본값)
  lastLoginAt       DateTime? // 마지막 로그인 시각
  adminMemo         String?   @db.Text // 최고관리자 전용 내부 메모
  emailVerifiedAt   DateTime? // 이메일 인증 완료 시각
  sessionVersion    Int       @default(0) // 비밀번호·역할 변경 시 올려서 기존 로그인 세션을 끊는다
  termsAgreedAt     DateTime? // 이용약관 동의 시각
  privacyAgreedAt   DateTime? // 개인정보 수집·이용 동의 시각
  withdrawnAt       DateTime? // 회원 탈퇴 시각 (개인정보는 지우고 거래 기록만 남긴다)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authTokens            AuthToken[]
  brandMembership       BrandMember?
  brandPartners         BrandPartner[]
  brandThreads          BrandThread[]           @relation("PartnerThreads")
  brandMessages         BrandMessage[]
  profile               Profile?
  ownedFacilities       Facility[]              @relation("FacilityOwner")
  managedFacilities     ManagerFacility[]
  bookings              Booking[]               @relation("SellerBookings")
  bookingWaitlist       BookingWaitlist[]
  liveSessions          LiveSession[]           @relation("SellerLiveSessions")
  orders                Order[]                 @relation("SellerOrders")
  kakaoChannels         KakaoChannel[]
  settlements           Settlement[]            @relation("SellerSettlements")
  managerCommission     ManagerCommissionRule[]
  auditLogs             AuditLog[]
  inquiries             FacilityInquiry[]       @relation("SellerInquiries")
  supportInquiries      SupportInquiry[]
  reviews               FacilityReview[]        @relation("SellerReviews")
  favorites             FacilityFavorite[]
  brandFavorites        BrandProductFavorite[]
  notifications         UserNotification[]
  marketingApplications MarketingApplication[]
  promotions            SellerPromotion[]
  coupons               SellerCoupon[]
  marketingAssets       MarketingAsset[]
  snsAccounts           SnsAccount[]
  snsPosts              SnsPost[]
  brandShop             BrandShop?
  brandRequests         BrandRequest[]
  sellerBrandProducts   SellerBrandProduct[]
  purchaseOrders        PurchaseOrder[]         @relation("SellerPurchaseOrders")
}

// 브랜드 상품 배송 방식
enum FulfillmentMode {
  DROPSHIP // 브랜드 직배송: 판매되면 발주서가 브랜드로 가고, 브랜드가 구매자에게 직접 배송
  WAREHOUSE // 창고 입고: 브랜드가 창고에 미리 입고(위탁), 창고가 출고. 판매되면 정산용 발주서 생성
}

enum PurchaseOrderStatus {
  NEW // 신규 발주 (브랜드 확인 전)
  CONFIRMED // 발주 확인
  SHIPPED // 출고·배송 중
  DELIVERED // 배송 완료
  CANCELLED // 취소
  RETURNED // 반품·환불
}

enum BrandShopStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BrandRequestKind {
  SUPPLY
  SAMPLE
  DISPLAY // 방송 시연품: 셀러가 예약한 창고 · 스튜디오 · 쇼룸으로 방송 전에 보내는 상품 (예약 승인 시 자동 요청)
}

enum BrandRequestStatus {
  PENDING
  AWAITING_PAYMENT
  APPROVED
  SHIPPED
  COMPLETED
  REJECTED
  CANCELLED
  REFUNDED
}

model BrandShop {
  id                    String                      @id @default(cuid())
  ownerId               String                      @unique
  owner                 User                        @relation(fields: [ownerId], references: [id])
  name                  String
  tagline               String                      @default("")
  description           String                      @default("") @db.Text
  logoUrl               String                      @default("")
  bannerUrl             String                      @default("")
  backgroundUrl         String                      @default("")
  paymentInstructions   String                      @default("") @db.Text
  status                BrandShopStatus             @default(PENDING)
  moderationNote        String                      @default("")
  categories            String[]                    @default([]) // 취급 카테고리(대분류)
  businessNumber        String                      @default("") // 사업자등록번호
  ceoName               String                      @default("")
  csPhone               String                      @default("") // 고객센터·담당 연락처
  returnAddress         String                      @default("") // 반품·교환 주소
  bankName              String                      @default("") // 정산 은행
  bankAccount           String                      @default("")
  accountHolder         String                      @default("")
  feeRate               Float? // 브랜드별 수수료율(%) — 비우면 플랫폼 기본값
  requireSellerApproval Boolean                     @default(false) // 판매처(셀러·창고)가 상품을 가져가기 전에 브랜드 승인 필요
  lowStockThreshold     Int                         @default(10) // 재고 부족 알림 기준
  bankChangedAt         DateTime? // 정산 계좌 마지막 변경 시각
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  products              BrandProduct[]
  purchaseOrders        PurchaseOrder[]
  settlements           BrandSettlement[]
  members               BrandMember[]
  videos                BrandShopVideo[]
  partners              BrandPartner[]
  threads               BrandThread[]
  adjustments           BrandSettlementAdjustment[]

  @@index([status, createdAt])
}

model BrandProduct {
  id                  String                 @id @default(cuid())
  shopId              String
  shop                BrandShop              @relation(fields: [shopId], references: [id])
  name                String
  category            String
  description         String                 @default("") @db.Text
  imageUrl            String                 @default("")
  supplyPrice         Int
  stock               Int
  samplePrice         Int?
  sampleStock         Int                    @default(0)
  isActive            Boolean                @default(true)
  subCategory         String                 @default("")
  sku                 String                 @default("")
  consumerPrice       Int                    @default(0) // 권장 소비자가
  images              String[]               @default([]) // 추가 이미지
  options             String                 @default("") // 옵션: "색상:블랙,화이트|사이즈:S,M,L"
  allowDropship       Boolean                @default(true) // 브랜드 직배송 허용
  allowWarehouse      Boolean                @default(true) // 창고 입고(위탁) 허용
  shippingFee         Int                    @default(0) // 직배송 시 건당 배송비(브랜드 부담분 정산 차감 아님, 안내용)
  leadDays            Int                    @default(2) // 발주 후 출고 소요일
  sampleLimitPerBuyer Int                    @default(1) // 계정당 샘플 신청 한도(0 = 무제한)
  minSalePrice        Int? // 최저 판매가(비우면 공급가)
  // 2026-11-14 상품 등록 고도화 (셀러브릭스 방식): 브랜드가 공급가와 판매가를 함께 정한다
  salePrice           Int                    @default(0) // 판매가 (셀러가 라이브에서 파는 가격 · 0이면 미설정)
  priceRule           String                 @default("FLEX") // FLEX: 셀러가 최저 판매가 이상에서 정함 · FIXED: 판매가 고정
  optionVariants      Json                   @default("[]") // 옵션 조합별 [{ label, extra(추가 공급가), saleExtra(추가 판매가), soldOut }]
  taxType             String                 @default("TAXABLE") // TAXABLE 과세 · TAX_FREE 면세
  origin              String                 @default("") // 원산지
  manufacturer        String                 @default("") // 제조사 · 수입사
  returnShippingFee   Int                    @default(0) // 반품 배송비 (편도)
  exchangeShippingFee Int                    @default(0) // 교환 배송비 (왕복)
  minOrderQty         Int                    @default(1) // 창고 입고(위탁) 요청 최소 수량(MOQ). 샘플·직배송 가져오기에는 적용 안 함
  volume              String                 @default("") // 용량·중량 (상품 정보 고시)
  expiryInfo          String                 @default("") // 유통기한 또는 사용기한 (예: 제조일로부터 24개월)
  ingredients         String                 @default("") @db.Text // 전성분·원재료명
  certification       String                 @default("") // 인증·신고 사항 (예: 기능성 화장품 심사, KC 인증번호)
  lowStockNotifiedAt  DateTime? // 재고 부족 알림을 보낸 시각(재입고되면 비움)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  requests            BrandRequest[]
  facilityProducts    FacilityProduct[]
  sellerListings      SellerBrandProduct[]
  liveProducts        LiveSessionProduct[]
  poItems             PurchaseOrderItem[]
  favorites           BrandProductFavorite[]
  bookingItems        BookingBrandItem[]

  @@index([shopId, isActive])
}

model BrandRequest {
  id                  String             @id @default(cuid())
  productId           String
  product             BrandProduct       @relation(fields: [productId], references: [id])
  buyerId             String
  buyer               User               @relation(fields: [buyerId], references: [id])
  requestKey          String
  kind                BrandRequestKind
  status              BrandRequestStatus
  productName         String
  quantity            Int
  unitPrice           Int
  recipient           String
  phone               String
  address             String
  message             String             @default("")
  paymentInstructions String             @default("") @db.Text
  trackingNumber      String             @default("")
  carrier             String             @default("")
  rejectReason        String             @default("")
  facilityProductId   String? // 창고 입고 요청 대상 판매 상품
  paymentStatus       String             @default("NONE") // NONE | PAID | REFUNDED (유료 샘플은 플랫폼 결제)
  paidAmount          Int                @default(0)
  pgTransactionId     String?
  paidAt              DateTime?
  receivedAt          DateTime? // 창고 입고 완료 시각
  remindedAt          DateTime? // 응대 기한이 지나 브랜드에 다시 알린 시각
  brandSettlementId   String?
  brandSettlement     BrandSettlement?   @relation(fields: [brandSettlementId], references: [id])
  bookingItem         BookingBrandItem?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([buyerId, requestKey])
  @@index([brandSettlementId])
  @@index([buyerId, createdAt])
  @@index([productId, status])
}

enum SupportCategory {
  ACCOUNT
  SPACE_BOOKING
  LIVE
  ORDER_PAYMENT
  SETTLEMENT
  PARTNERSHIP
  OTHER
}

model SupportInquiry {
  id              String           @id @default(uuid())
  userId          String? // 비회원 문의는 비어 있다 (guest* 필드 사용)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestName       String?          @db.VarChar(40)
  guestEmail      String?          @db.VarChar(120)
  guestPhone      String?          @db.VarChar(30)
  guestToken      String?          @unique // 비회원이 답변을 확인하는 링크용 비밀 값
  category        SupportCategory
  subject         String           @db.VarChar(100)
  message         String           @db.Text
  reference       String?          @db.VarChar(100)
  reply           String?          @db.Text // (예전 단일 답변 — 지금은 SupportMessage 대화로 남긴다)
  answeredAt      DateTime? // 첫 답변 시각
  status          String           @default("OPEN") // OPEN(새 문의) | IN_PROGRESS(처리 중) | ANSWERED(답변 완료) | CLOSED(종료)
  priority        String           @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assigneeId      String? // 담당 최고관리자
  adminMemo       String?          @db.Text // 내부 메모 (고객에게 안 보임)
  attachments     String[]         @default([]) // 첨부 이미지 주소
  source          String           @default("PAGE") // PAGE | POPUP | CHATBOT
  chatTranscript  String?          @db.Text // 챗봇 대화에서 넘어온 문의면 대화 기록
  pagePath        String?          @db.VarChar(200) // 문의를 연 화면
  lastUserReplyAt DateTime? // 고객이 마지막으로 추가 문의한 시각
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  messages        SupportMessage[]

  @@index([userId, createdAt])
  @@index([answeredAt, createdAt])
  @@index([category, createdAt])
  @@index([status, createdAt])
}

/// 문의 대화 (고객 추가 문의 · 운영팀 답변)
model SupportMessage {
  id          String         @id @default(cuid())
  inquiryId   String
  inquiry     SupportInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author      String // USER | ADMIN
  authorId    String?
  body        String         @db.Text
  attachments String[]       @default([])
  createdAt   DateTime       @default(now())

  @@index([inquiryId, createdAt])
}

/// 운영팀 답변 템플릿 (최고관리자)
model SupportTemplate {
  id        String           @id @default(cuid())
  title     String           @db.VarChar(60)
  body      String           @db.Text
  category  SupportCategory?
  createdBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  companyName     String?
  businessNumber  String?
  categories      String[]  @default([]) // 관심·취급 카테고리
  avatarUrl       String?
  // 셀러 정산 계좌 (판매 정산 지급용)
  bankName        String?
  bankAccount     String?
  accountHolder   String?
  bankChangedAt   DateTime?
  snsLinks        Json? // 내 SNS 주소 { instagram, youtube, tiktok }
  livePlatforms   String[]  @default([]) // 셀러가 판매하는 라이브 커머스 플랫폼 (src/lib/live-platforms.ts 의 코드)
  livePlatformEtc String? // '기타 플랫폼' 직접 입력
  notifyPrefs     Json? // 알림 받기 설정 { order, settlement, live } (false 면 끔)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ===================== Facilities =====================
model Facility {
  id                  String            @id @default(cuid())
  ownerId             String // 본사 운영 계정(최고관리자). 브랜드 거래(판매처 · 샘플 · 입고 신청)의 주체로 쓴다
  owner               User              @relation("FacilityOwner", fields: [ownerId], references: [id])
  name                String
  type                FacilityType
  status              FacilityStatus    @default(PENDING)
  operationType       FacilityOperation @default(DIRECT) // 직영 / 제휴
  partnerName         String? // 제휴 업체명 (제휴 창고)
  partnerContactName  String? // 제휴 창고 담당자 (계정 없이 정보로만 저장)
  partnerContactPhone String?
  partnerContactEmail String? // 입력하면 새 예약 · 출고할 주문 등을 메일로도 보낸다
  region              String // 지역 (예: 서울, 부산)
  address             String
  description         String?
  equipment           String? // 보유 장비 (콤마 구분 또는 자유 텍스트)
  specialty           String? // 전문 카테고리 (콤마 구분: 의류,코스메틱,식품 등)
  liveSpaceInfo       String? // 라이브 공간 안내 (조명/카메라/인터넷 등)
  openTime            String? // "09:00"
  closeTime           String? // "22:00"
  basePrice           Int               @default(0) // (사용 안 함) 창고(스튜디오) 이용료는 무료 — 과거 데이터 호환용
  rating              Float             @default(0)
  thumbnailUrl        String?
  contactPhone        String? // 현장 연락처
  capacity            Int? // 최대 수용 인원
  minHours            Int               @default(1) // 최소 예약 시간(시간)
  cancelPolicy        String?           @db.Text // 취소·환불 규정
  bankName            String? // 정산 은행
  bankAccount         String? // 정산 계좌번호
  accountHolder       String? // 예금주
  // ---- 예약 정책 (창고(스튜디오)별) ----
  bookingUnitMinutes  Int               @default(60) // 예약 시작 단위(분): 30 | 60
  bufferMinutes       Int               @default(0) // 예약 사이 준비·정리 시간(분)
  minLeadHours        Int               @default(0) // 최소 몇 시간 전까지 예약 가능
  maxAdvanceDays      Int               @default(60) // 최대 며칠 앞까지 예약 가능
  maxHours            Int               @default(12) // 1회 최대 이용 시간
  autoApprove         Boolean           @default(false) // 즉시 확정(승인 절차 생략)
  cancelDeadlineHours Int               @default(24) // 셀러 직접 취소·변경 마감(이용 시작 n시간 전)
  bookingNotice       String?           @db.Text // 예약 안내사항(셀러에게 표시)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  waitlist            BookingWaitlist[]
  reviews             FacilityReview[]
  favorites           FacilityFavorite[]
  facilitySettlements FacilitySettlement[]
  images              FacilityImage[]
  slots               FacilityAvailableSlot[]
  blackoutDates       FacilityBlackoutDate[]
  managers            ManagerFacility[]
  products            FacilityProduct[]
  bookings            Booking[]
  liveSessions        LiveSession[]
  orders              Order[]
  settlements         Settlement[]
  inquiries           FacilityInquiry[]
  timeBlocks          FacilityTimeBlock[]
  purchaseOrders      PurchaseOrder[]

  @@index([region])
  @@index([type])
  @@index([status])
}

// ===================== 창고(스튜디오) 문의 =====================
model FacilityInquiry {
  id         String    @id @default(cuid())
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User      @relation("SellerInquiries", fields: [sellerId], references: [id])
  message    String    @db.Text
  reply      String?   @db.Text
  repliedAt  DateTime?
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([facilityId])
  @@index([sellerId])
}

model FacilityImage {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
}

// 예약 가능 시간대(반복 슬롯)
model FacilityAvailableSlot {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  weekday    Int // 0=일 ~ 6=토
  startTime  String // "10:00"
  endTime    String // "12:00"
  isActive   Boolean  @default(true)

  @@index([facilityId])
}

// 예약 불가일
model FacilityBlackoutDate {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  date       DateTime
  reason     String?

  @@unique([facilityId, date])
}

// 시간대 예약 차단 (하루 중 일부 시간만 막기: 내부 촬영, 점검 등)
model FacilityTimeBlock {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([facilityId, startAt])
}

// 중간관리자 - 창고(스튜디오) 매핑 (영업한 창고(스튜디오))
model ManagerFacility {
  id         String   @id @default(cuid())
  managerId  String
  manager    User     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([managerId, facilityId])
  @@index([facilityId])
}

// ===================== Products =====================
// products: 마스터 상품 카탈로그(창고(스튜디오) 무관)
model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String?
  category     String
  description  String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images           ProductImage[]
  options          ProductOption[]
  facilityProducts FacilityProduct[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model ProductOption {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // 예: 색상
  value      String // 예: 블랙
  extraPrice Int     @default(0)
  stock      Int     @default(0)
}

// facility_products: 창고(스튜디오)에서 판매 가능한 상품 + 가격/재고/수수료
model FacilityProduct {
  id              String           @id @default(cuid())
  facilityId      String
  facility        Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  salePrice       Int // 판매가(원) — 구매자 결제가
  consumerPrice   Int // 소비자가(원)
  supplyPrice     Int? // 셀러 공급가(원): 판매되면 창고(스튜디오)가 받는 금액. 비우면 셀러 수수료 방식
  stock           Int              @default(0)
  shippingInfo    String?
  commissionType  CommissionType   @default(PERCENT)
  commissionValue Float            @default(0) // PERCENT: %, FIXED: 원
  isSellable      Boolean          @default(true)
  source          ProductSource    @default(CATALOG)
  brandProductId  String? // 브랜드에서 가져온 상품이면 연결
  brandProduct    BrandProduct?    @relation(fields: [brandProductId], references: [id])
  fulfillment     FulfillmentMode? // 브랜드 상품의 배송 방식
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  liveSessionProducts LiveSessionProduct[]
  bookingProducts     BookingProduct[]

  @@index([facilityId])
  @@index([brandProductId])
}

// ===================== Bookings =====================
model Booking {
  id                   String              @id @default(cuid())
  facilityId           String
  facility             Facility            @relation(fields: [facilityId], references: [id])
  sellerId             String
  seller               User                @relation("SellerBookings", fields: [sellerId], references: [id])
  status               BookingStatus       @default(PENDING)
  startAt              DateTime
  endAt                DateTime
  purpose              String? // 방송 목적
  expectedProducts     String? // 예상 판매 상품
  rejectReason         String?
  totalPrice           Int                 @default(0) // (사용 안 함) 이용료 무료 — 항상 0
  code                 String?             @unique // 예약번호 (예: SB-261110-7K3Q)
  groupId              String? // 반복 예약 묶음 id
  rescheduleCount      Int                 @default(0) // 일정 변경 횟수
  headcount            Int? // 방문 인원
  requestNote          String?             @db.Text // 셀러 요청사항
  facilityMemo         String?             @db.Text // 창고(스튜디오) 내부 메모 (셀러에게 비공개)
  cancelReason         String?
  approvedAt           DateTime?
  cancelledAt          DateTime?
  completedAt          DateTime?
  checkedInAt          DateTime? // 현장 체크인
  noShowAt             DateTime? // 노쇼 처리 시각
  reminderSentAt       DateTime? // 이용 전 알림 발송 시각
  facilitySettlementId String?
  facilitySettlement   FacilitySettlement? @relation(fields: [facilitySettlementId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  liveSession LiveSession?
  review      FacilityReview?
  products    BookingProduct[]
  brandItems  BookingBrandItem[] // 방송할 브랜드 상품 (시연품 요청)

  @@index([facilityId, startAt])
  @@index([groupId])
  @@index([sellerId])
  @@index([status])
  @@index([facilitySettlementId])
}

// ===================== Live Sessions =====================
model LiveSession {
  id               String             @id @default(cuid())
  slug             String             @unique // 구매자용 링크 식별자
  bookingId        String?            @unique
  booking          Booking?           @relation(fields: [bookingId], references: [id])
  sellerId         String
  seller           User               @relation("SellerLiveSessions", fields: [sellerId], references: [id])
  facilityId       String? // 비어 있으면 셀러 본인 공간 방송 (셀러가 가져온 브랜드 직배송 상품 판매)
  facility         Facility?          @relation(fields: [facilityId], references: [id])
  title            String
  description      String?
  status           LiveStatus         @default(DRAFT)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  buyerLinkUrl     String? // (사용 안 함) 예전 구매자용 방송 링크
  isOrderSheet     Boolean            @default(false) // 셀러 주문서를 담는 내부 묶음 (방송 아님 · 방송 목록에 보이지 않음)
  alimtalkStatus   NotificationStatus @default(PENDING)
  numberVersion    Int                @default(0) // 상품번호 변경 폴링용 버전
  endedAt          DateTime? // 방송 종료 시각 (종료 후 주문 허용 시간 계산)
  shippingFee      Int                @default(0) // 셀러가 정한 배송비(원, 0 = 무료 · 상품가 포함)
  freeShippingOver Int? // 이 금액 이상 주문하면 배송비 무료
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  products       LiveSessionProduct[]
  numberHistory  LiveProductNumberHistory[]
  orders         Order[]
  streamChannels StreamChannel[]
  notifications  NotificationLog[]

  @@index([sellerId])
  @@index([facilityId])
}

// 방송에서 판매하는 상품 + 상품번호
model LiveSessionProduct {
  id                      String           @id @default(cuid())
  liveSessionId           String
  liveSession             LiveSession      @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  facilityProductId       String?
  facilityProduct         FacilityProduct? @relation(fields: [facilityProductId], references: [id])
  displayNumber           Int // 구매자에게 보이는 상품번호
  sortOrder               Int              @default(0)
  // 임시상품(스냅샷) 필드 - facilityProduct 없이도 동작
  nameSnapshot            String
  priceSnapshot           Int
  stockSnapshot           Int              @default(0)
  imageSnapshot           String?
  optionSnapshot          String? // JSON 문자열
  source                  ProductSource    @default(CATALOG)
  isActive                Boolean          @default(true)
  brandProductId          String? // 브랜드 상품이면 연결 (발주서 생성 기준)
  brandProduct            BrandProduct?    @relation(fields: [brandProductId], references: [id])
  fulfillment             FulfillmentMode?
  supplyPriceSnapshot     Int? // 방송에 올릴 때의 브랜드 공급가
  facilitySupplySnapshot  Int? // 방송에 올릴 때의 창고(스튜디오) 셀러 공급가
  commissionTypeSnapshot  CommissionType? // 방송에 올릴 때의 셀러 수수료 방식
  commissionValueSnapshot Float?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  orderItems OrderItem[]

  @@unique([liveSessionId, displayNumber])
  @@index([liveSessionId])
}

// 상품번호 변경 이력
model LiveProductNumberHistory {
  id                   String      @id @default(cuid())
  liveSessionId        String
  liveSession          LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  liveSessionProductId String
  oldNumber            Int?
  newNumber            Int
  changedBy            String // userId
  changedAt            DateTime    @default(now())

  @@index([liveSessionId])
}

// ===================== Orders & Payments =====================
model Order {
  id                 String      @id @default(cuid())
  orderNo            String      @unique
  // 셀러 주문서 (2026-11-14~): 셀러가 외부 라이브 플랫폼에서 판 주문을 직접 작성한다. buyer* = 받는 분, totalAmount = 셀러 결제액(공급가 + 스토리지마켓 출고 배송비)
  source             String      @default("LIVE") // SHEET(셀러 주문서) | LIVE(예전 구매자 직접 주문) — 주문서는 코드에서 SHEET 로 저장
  platform           String? // 판매한 플랫폼 코드 (src/lib/live-platforms.ts)
  externalOrderNo    String? // 외부 플랫폼 주문번호
  sheetMemo          String? // 배송 메모
  liveSessionId      String
  liveSession        LiveSession @relation(fields: [liveSessionId], references: [id])
  sellerId           String
  seller             User        @relation("SellerOrders", fields: [sellerId], references: [id])
  facilityId         String?
  facility           Facility?   @relation(fields: [facilityId], references: [id])
  buyerName          String
  buyerPhone         String
  buyerAddress       String?
  status             OrderStatus @default(ORDER_CREATED)
  totalAmount        Int // 결제 금액 = 상품 합계 + 배송비
  shippingFee        Int         @default(0) // 주문 시 적용된 배송비 (셀러 몫)
  // 판매처 직접 출고분(창고(스튜디오) 상품 · 위탁 상품 · 셀러 공간 임시 상품)의 배송. 브랜드 직배송분은 발주서에서 관리
  shipCarrier        String?
  shipTrackingNumber String?
  localShippedAt     DateTime?
  localDeliveredAt   DateTime?
  refundedAmount     Int         @default(0) // 부분 취소·환불된 금액 합계
  discountAmount     Int         @default(0) // 셀러 쿠폰 할인 금액 (셀러 몫에서 빠진다)
  couponId           String? // 사용한 셀러 쿠폰
  couponCode         String?
  deliveredAt        DateTime? // 배송 완료 시각 (구매 확정 유예·정산 기간 기준)
  privacyAgreedAt    DateTime? // 구매자 개인정보 수집·제3자 제공 동의 시각
  settlementId       String? // 판매 정산서에 포함되면 연결 (중복 정산 방지)
  settlement         Settlement? @relation(fields: [settlementId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items          OrderItem[]
  payment        Payment?
  purchaseOrders PurchaseOrder[]
  claims         OrderClaim[]

  @@index([liveSessionId])
  @@index([sellerId])
  @@index([facilityId])
  @@index([settlementId])
  @@index([createdAt])
  @@index([status])
}

enum OrderClaimType {
  CANCEL // 주문 취소
  RETURN // 반품
  EXCHANGE // 교환
}

enum OrderClaimStatus {
  REQUESTED // 구매자가 요청함 (판매자 확인 대기)
  RESOLVED // 판매자가 처리함
  REJECTED // 판매자가 거절함
  WITHDRAWN // 구매자가 요청을 거둠
}

// 구매자 취소 · 반품 · 교환 요청 (비회원 구매자가 주문 화면에서 남긴다)
model OrderClaim {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       OrderClaimType
  status     OrderClaimStatus @default(REQUESTED)
  reason     String
  detail     String?
  answer     String? // 판매자 답변 (구매자에게 보임)
  resolvedBy String? // 처리한 사용자 id
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id                   String              @id @default(cuid())
  orderId              String
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  liveSessionProductId String
  liveSessionProduct   LiveSessionProduct  @relation(fields: [liveSessionProductId], references: [id])
  displayNumber        Int
  productName          String
  unitPrice            Int
  quantity             Int
  optionLabel          String?
  lineTotal            Int
  discountAmount       Int                 @default(0) // 이 줄에 나눠 넣은 쿠폰 할인 (환불 · 정산은 lineTotal - discountAmount 기준)
  cancelledAt          DateTime? // 부분 취소된 줄
  // 주문 시점에 확정한 수익 분배 (이후 수수료·공급가가 바뀌어도 그대로). 비어 있으면 예전 주문
  platformFee          Int?
  brandAmount          Int?
  facilityAmount       Int?
  sellerAmount         Int?
  poItems              PurchaseOrderItem[]
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String        @default("mock")
  method          PaymentMethod
  status          PaymentStatus @default(READY)
  amount          Int
  pgTransactionId String?
  approvedAt      DateTime?
  failReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events PaymentEvent[]
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String // CREATED|CONFIRMED|FAILED|CANCELLED|REFUNDED|WEBHOOK
  payload   String? // JSON
  eventKey  String?  @unique // 웹훅 중복 처리 방지용 (같은 통지는 한 번만 반영)
  createdAt DateTime @default(now())

  @@index([paymentId])
}

// ===================== Commission & Settlement =====================
// 기본 수수료 정책(창고(스튜디오)/플랫폼 단위 기본값)
model CommissionRule {
  id              String         @id @default(cuid())
  scope           String // PLATFORM | FACILITY
  facilityId      String?
  commissionType  CommissionType @default(PERCENT)
  commissionValue Float          @default(0)
  createdAt       DateTime       @default(now())
}

// 중간관리자 수수료 (SUPER_ADMIN 만 설정)
model ManagerCommissionRule {
  id              String         @id @default(cuid())
  managerId       String
  manager         User           @relation(fields: [managerId], references: [id], onDelete: Cascade)
  commissionType  CommissionType @default(PERCENT)
  commissionValue Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([managerId])
}

model Settlement {
  id               String            @id @default(cuid())
  sellerId         String
  seller           User              @relation("SellerSettlements", fields: [sellerId], references: [id])
  facilityId       String?
  facility         Facility?         @relation(fields: [facilityId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Int // 총 매출
  commissionAmount Int // 셀러 수수료(셀러 수익)
  facilityAmount   Int // 창고(스튜디오) 정산금
  platformFee      Int               @default(0) // 플랫폼 판매 수수료
  brandAmount      Int               @default(0) // 브랜드 공급대금(브랜드 정산으로 따로 지급)
  orderCount       Int               @default(0)
  adjustmentCount  Int               @default(0) // 정산 후 취소·환불로 차감한 건수
  status           SettlementStatus  @default(PENDING)
  confirmedAt      DateTime?
  paidAt           DateTime?
  memo             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  adjustments      SalesAdjustment[]

  @@index([sellerId])
  @@index([facilityId])
}

// ===================== Kakao Alimtalk =====================
model KakaoChannel {
  id           String   @id @default(cuid())
  sellerId     String
  seller       User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  channelName  String
  plusFriendId String?
  senderKey    String?
  createdAt    DateTime @default(now())

  subscribers KakaoSubscriber[]

  @@index([sellerId])
}

model KakaoSubscriber {
  id        String       @id @default(cuid())
  channelId String
  channel   KakaoChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String?
  phone     String
  createdAt DateTime     @default(now())

  @@index([channelId])
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  content   String // {방송링크} 등 변수 포함
  createdAt DateTime @default(now())
}

model NotificationLog {
  id            String             @id @default(cuid())
  liveSessionId String?
  liveSession   LiveSession?       @relation(fields: [liveSessionId], references: [id])
  channelId     String?
  templateCode  String?
  recipient     String
  content       String
  status        NotificationStatus @default(PENDING)
  provider      String             @default("mock")
  error         String?
  createdAt     DateTime           @default(now())

  @@index([liveSessionId])
}

// ===================== 방송 채널 =====================
// 스토리지마켓은 직접 송출하지 않는다. 셀러가 유튜브 · 인스타그램 · 틱톡 등 외부 채널에서 방송하고,
// 그 주소를 등록하면 구매자 방송 화면(주문 페이지)에 영상 · '앱에서 보기'로 연결된다.
// 다른 서비스(예: 셀러브릭스)와 연동할 때는 type=ETC 와 externalId 로 연결할 수 있다.
model StreamChannel {
  id            String         @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession    @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  type          SnsChannelType
  url           String?
  externalId    String?
  createdAt     DateTime       @default(now())

  @@index([liveSessionId])
}

// ===================== Audit =====================
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      String? // JSON
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// 사이트 전역 설정 (배너, 사이트 정보, 라이브 기능 on/off 등)
// key-value 저장소. 값은 문자열로 보관하고 앱에서 파싱한다.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ===================== 리뷰 · 즐겨찾기 =====================
// 이용 완료된 예약 1건당 리뷰 1개. 창고(스튜디오) 평점(rating)은 공개 리뷰 평균으로 갱신한다.
model FacilityReview {
  id         String    @id @default(cuid())
  bookingId  String    @unique
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User      @relation("SellerReviews", fields: [sellerId], references: [id])
  rating     Int // 1~5
  content    String    @db.Text
  reply      String?   @db.Text
  repliedAt  DateTime?
  isHidden   Boolean   @default(false) // 최고관리자 숨김 처리
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([facilityId])
  @@index([sellerId])
}

model FacilityFavorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, facilityId])
}

// ===================== 창고(스튜디오) 예약 정산 =====================
// 기간 내 이용 완료 예약의 이용료 합계에서 플랫폼 수수료를 뺀 금액을 창고(스튜디오)에 지급한다.
// (사용 안 함) 예전 창고 이용료 정산 — 이용료가 무료가 되어 새로 만들지 않는다. 옛 기록 보존용
model FacilitySettlement {
  id           String           @id @default(cuid())
  facilityId   String
  facility     Facility         @relation(fields: [facilityId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  bookingCount Int              @default(0)
  grossAmount  Int // 이용료 합계
  feeRate      Float            @default(0) // 플랫폼 수수료율(%)
  platformFee  Int // 플랫폼 수수료
  payoutAmount Int // 지급액
  status       SettlementStatus @default(PENDING)
  confirmedAt  DateTime?
  paidAt       DateTime?
  memo         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  bookings Booking[]

  @@index([facilityId])
  @@index([status])
}

// ===================== 알림 =====================
model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // BOOKING|INQUIRY|REVIEW|SETTLEMENT|MARKETING|SYSTEM
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ===================== 셀러 마케팅 =====================
// 마케팅 지원 신청 (최고관리자가 검토)
model MarketingApplication {
  id        String    @id @default(cuid())
  sellerId  String
  seller    User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type      String // SNS_AD|CONTENT|INFLUENCER|ETC
  title     String
  content   String    @db.Text
  budget    Int?
  desiredAt DateTime?
  status    String    @default("PENDING") // PENDING|IN_REVIEW|APPROVED|REJECTED|DONE
  adminNote String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sellerId])
  @@index([status])
}

// 이벤트 · 프로모션
model SellerPromotion {
  id            String         @id @default(cuid())
  sellerId      String
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String?        @db.Text
  channel       String? // 진행 채널 (유튜브, 인스타그램 등)
  discountType  CommissionType @default(PERCENT)
  discountValue Float          @default(0)
  startAt       DateTime
  endAt         DateTime
  targetAmount  Int? // 목표 매출
  resultAmount  Int? // 실제 매출(직접 입력)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sellerId])
}

// 쿠폰
model SellerCoupon {
  id            String         @id @default(cuid())
  sellerId      String
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name          String
  code          String         @unique
  discountType  CommissionType @default(PERCENT)
  discountValue Float
  minAmount     Int            @default(0)
  maxDiscount   Int?
  totalQty      Int? // null = 무제한
  usedQty       Int            @default(0)
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sellerId])
}

// 광고 소재 보관함
model MarketingAsset {
  id         String   @id @default(cuid())
  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title      String
  type       String // IMAGE|VIDEO|COPY|LINK
  url        String?
  content    String?  @db.Text
  channel    String?
  tags       String? // 콤마 구분
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sellerId])
}

// SNS 계정 (셀러가 직접 등록·갱신)
model SnsAccount {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  platform  String // YOUTUBE|INSTAGRAM|TIKTOK|FACEBOOK|NAVER|ETC
  handle    String
  url       String?
  followers Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, platform, handle])
}

// SNS 콘텐츠 캘린더
model SnsPost {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  platform    String
  title       String
  memo        String?  @db.Text
  scheduledAt DateTime
  status      String   @default("PLANNED") // PLANNED|POSTED|CANCELLED
  url         String?
  views       Int?
  likes       Int?
  comments    Int?
  clicks      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, scheduledAt])
}

// ===================== 예약 상품 · 대기 =====================
// 셀러가 예약할 때 방송에서 판매하려고 고른 창고(스튜디오) 상품. 라이브 세션을 만들면 자동으로 판매 상품에 들어간다.
model BookingProduct {
  id                String          @id @default(cuid())
  bookingId         String
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  facilityProductId String
  facilityProduct   FacilityProduct @relation(fields: [facilityProductId], references: [id])
  quantity          Int             @default(1) // 방송 판매 예정 수량
  nameSnapshot      String
  priceSnapshot     Int
  commissionType    CommissionType  @default(PERCENT)
  commissionValue   Float           @default(0)
  status            String          @default("REQUESTED") // REQUESTED | CONFIRMED | UNAVAILABLE
  facilityNote      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([bookingId, facilityProductId])
  @@index([facilityProductId])
}

// 이미 다른 예약이 잡힌 시간에 대기 신청. 해당 예약이 취소·거절되면 알림을 보낸다.
model BookingWaitlist {
  id         String    @id @default(cuid())
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  note       String?
  status     String    @default("WAITING") // WAITING | NOTIFIED | BOOKED | CANCELLED
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([facilityId, startAt])
  @@index([sellerId, status])
}

// ===================== 브랜드 판매 연결 · 발주 · 정산 =====================
// 셀러가 브랜드샵에서 "판매 상품으로 가져오기"한 상품 (브랜드 직배송). 라이브 방송 상품으로 바로 올릴 수 있다.
model SellerBrandProduct {
  id             String       @id @default(cuid())
  sellerId       String
  seller         User         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brandProductId String
  brandProduct   BrandProduct @relation(fields: [brandProductId], references: [id])
  salePrice      Int // 셀러 판매가
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([sellerId, brandProductId])
  @@index([brandProductId])
}

// 발주서: 구매자 결제가 끝나면 브랜드별 · 배송방식별로 자동 생성된다.
model PurchaseOrder {
  id                     String              @id @default(cuid())
  poNo                   String              @unique // 예: PO-261111-7K3QX
  brandShopId            String
  brandShop              BrandShop           @relation(fields: [brandShopId], references: [id])
  orderId                String
  order                  Order               @relation(fields: [orderId], references: [id])
  facilityId             String?
  facility               Facility?           @relation(fields: [facilityId], references: [id])
  sellerId               String
  seller                 User                @relation("SellerPurchaseOrders", fields: [sellerId], references: [id])
  fulfillment            FulfillmentMode
  status                 PurchaseOrderStatus @default(NEW)
  recipient              String // 직배송: 구매자 / 창고 입고: 창고
  phone                  String
  address                String              @default("")
  saleAmount             Int // 판매 금액 합계
  supplyAmount           Int // 공급가 합계 (브랜드 정산 기준)
  carrier                String              @default("")
  trackingNumber         String              @default("")
  brandMemo              String              @default("")
  adminMemo              String              @default("")
  cancelReason           String              @default("")
  cancelRequestedAt      DateTime? // 브랜드가 출고 불가(취소 요청)를 보낸 시각
  cancelRequestReason    String              @default("")
  returnReceivedAt       DateTime? // 반품 상품을 브랜드가 받은 시각
  exchangeCarrier        String              @default("")
  exchangeTrackingNumber String              @default("")
  exchangeShippedAt      DateTime? // 교환 상품 재발송 시각
  confirmedAt            DateTime?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  cancelledAt            DateTime?
  brandSettlementId      String?
  brandSettlement        BrandSettlement?    @relation(fields: [brandSettlementId], references: [id])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  items       PurchaseOrderItem[]
  adjustments BrandSettlementAdjustment[]

  @@unique([orderId, brandShopId, fulfillment])
  @@index([brandShopId, status, createdAt])
  @@index([status, createdAt])
  @@index([brandSettlementId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  brandProductId  String
  brandProduct    BrandProduct  @relation(fields: [brandProductId], references: [id])
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  productName     String
  optionLabel     String?
  quantity        Int
  supplyPrice     Int
  salePrice       Int

  @@index([purchaseOrderId])
  @@index([brandProductId])
}

// 브랜드 정산서 (최고관리자가 기간별로 생성 → 확정 → 지급)
model BrandSettlement {
  id             String           @id @default(cuid())
  brandShopId    String
  brandShop      BrandShop        @relation(fields: [brandShopId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  poCount        Int              @default(0)
  sampleCount    Int              @default(0)
  supplyAmount   Int              @default(0) // 발주 공급가 합계
  sampleAmount   Int              @default(0) // 유료 샘플 결제 합계
  grossAmount    Int              @default(0) // 정산 대상 합계
  feeRate        Float            @default(0)
  platformFee    Int              @default(0)
  adjustment     Int              @default(0) // 최고관리자 수동 조정(+/-)
  autoAdjustment Int              @default(0) // 정산 후 반품·취소로 자동 차감한 금액(음수)
  payoutAmount   Int              @default(0)
  status         SettlementStatus @default(PENDING)
  confirmedAt    DateTime?
  paidAt         DateTime?
  memo           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  purchaseOrders PurchaseOrder[]
  sampleRequests BrandRequest[]
  adjustments    BrandSettlementAdjustment[]

  @@index([brandShopId])
  @@index([status])
}

// 플랫폼 운영 정책 (최고관리자가 수정) — 한 행(id="default")만 사용
model PlatformPolicy {
  id                     String   @id @default("default")
  salesFeeRate           Float    @default(5) // 판매 금액 대비 플랫폼 수수료(%) — 창고(스튜디오)/셀러 몫에서 차감
  brandFeeRate           Float    @default(5) // 브랜드 공급대금 대비 수수료(%)
  sampleFeeRate          Float    @default(0) // 유료 샘플 결제 대비 수수료(%)
  sellerShareRate        Float    @default(70) // 셀러가 가져온 브랜드 직배송 상품: (판매가-공급가-플랫폼수수료) 중 셀러 몫(%) — 나머지는 방송 장소 창고(스튜디오)
  pendingExpireHours     Int      @default(48) // 승인 대기 예약 자동 만료(시간, 0 = 끄기)
  noShowGraceMinutes     Int      @default(30) // 시작 후 n분 지나면 노쇼 처리 가능
  autoCompleteBookings   Boolean  @default(true) // 종료 시간이 지난 승인 예약 자동 이용 완료
  reminderHoursBefore    Int      @default(24) // 이용 n시간 전 알림
  poConfirmHours         Int      @default(24) // 브랜드 발주 확인 권장 시간(지연 표시 기준)
  sampleMaxPerOrder      Int      @default(20) // 샘플 주문당 최대 수량
  orderAfterEndHours     Int      @default(0) // (사용 안 함) 방송 종료 후 주문을 받는 시간
  sheetShippingFee       Int      @default(3000) // 셀러 주문서: 스토리지마켓(창고)이 출고하는 주문의 건당 배송비 — 셀러가 결제, 출고한 창고 몫
  liveAutoEndHours       Int      @default(2) // 예약(방송 예정) 종료 시각이 지나고 n시간 뒤에도 방송 중이면 자동 종료 (0 = 끄기)
  settleAfterDays        Int      @default(7) // 배송 완료 후 n일이 지나야 정산 대상(구매 확정 유예, 보통 7)
  piiRetentionDays       Int      @default(90) // 배송 완료 n일 후 브랜드 화면에서 구매자 연락처·주소 가림
  requireEmailVerify     Boolean  @default(false) // 이메일 인증한 계정만 예약·방송·브랜드 거래 가능
  maxPendingBookings     Int      @default(10) // 셀러 한 명이 동시에 가질 수 있는 승인 대기 예약 수
  requestReplyHours      Int      @default(72) // 샘플·입고 요청 응대 기한(시간). 지나면 브랜드에 다시 알림 (0 = 끄기)
  requestAutoRejectHours Int      @default(72) // 응대 기한 후 이 시간이 더 지나도 응답이 없으면 자동 반려·유료 샘플 환불 (0 = 끄기)
  updatedBy              String?
  updatedAt              DateTime @updatedAt
}

// ===================== 인증 · 보안 =====================
// 비밀번호 재설정 · 이메일 인증 토큰 (원문은 메일로만 보내고 DB에는 해시만 저장)
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // PASSWORD_RESET | EMAIL_VERIFY
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// 요청 횟수 제한 (로그인 실패 · 주문 · 주문 조회 · 비밀번호 재설정). 서버가 여러 대여도 공유된다.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// ===================== 브랜드 협업 =====================
// 브랜드 팀원 계정 (대표 계정이 만든 직원 계정 — 정산 계좌·팀 관리는 대표만)
model BrandMember {
  id        String    @id @default(cuid())
  shopId    String
  shop      BrandShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([shopId])
}

// 판매처 관리: 브랜드가 셀러·창고(스튜디오) 관리자를 승인하거나 차단한다.
model BrandPartner {
  id        String    @id @default(cuid())
  shopId    String
  shop      BrandShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING") // PENDING | APPROVED | BLOCKED
  note      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([shopId, userId])
  @@index([userId])
}

// 브랜드 ↔ 판매처 1:1 문의
model BrandThread {
  id            String         @id @default(cuid())
  shopId        String
  shop          BrandShop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       User           @relation("PartnerThreads", fields: [partnerId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime       @default(now())
  brandUnread   Int            @default(0)
  partnerUnread Int            @default(0)
  createdAt     DateTime       @default(now())
  messages      BrandMessage[]

  @@unique([shopId, partnerId])
  @@index([partnerId])
}

model BrandMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    BrandThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String      @db.Text
  flagged   Boolean     @default(false) // 전화번호·계좌번호 등 직거래 의심 내용 포함
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}

// ===================== 정산 후 조정 =====================
// 이미 정산된 발주가 반품·취소되면 다음 브랜드 정산에서 자동 차감한다.
model BrandSettlementAdjustment {
  id              String           @id @default(cuid())
  brandShopId     String
  brandShop       BrandShop        @relation(fields: [brandShopId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  amount          Int // 음수 = 차감
  reason          String           @default("")
  settlementId    String?
  settlement      BrandSettlement? @relation(fields: [settlementId], references: [id])
  createdAt       DateTime         @default(now())

  @@index([brandShopId, settlementId])
}

// 이미 판매 정산된 주문이 환불·부분 취소되면 다음 판매 정산에서 자동 차감한다. (금액은 음수)
model SalesAdjustment {
  id             String      @id @default(cuid())
  sellerId       String
  facilityId     String?
  orderId        String
  grossAmount    Int
  sellerAmount   Int
  facilityAmount Int
  platformFee    Int
  brandAmount    Int
  reason         String      @default("")
  settlementId   String?
  settlement     Settlement? @relation(fields: [settlementId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([sellerId, facilityId, settlementId])
}

// 셀러 · 창고(스튜디오)가 찜한 브랜드 상품
model BrandProductFavorite {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProductId String
  brandProduct   BrandProduct @relation(fields: [brandProductId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, brandProductId])
  @@index([brandProductId])
}

// 사이트 공지 (최고관리자 작성, 메인·대시보드에 노출)
model SiteNotice {
  id          String   @id @default(cuid())
  title       String
  body        String   @default("") @db.Text
  link        String   @default("") // 자세히 보기 링크(선택)
  audience    String   @default("ALL") // ALL | SELLER | FACILITY_ADMIN | BRAND_ADMIN
  isPublished Boolean  @default(true)
  pinned      Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}

/// 메인 '라이브 커머스' 플레이어에 보여 줄 외부 방송 (2026-11-14)
///  - MANUAL: 최고관리자가 외부 방송 주소(유튜브 · 그립 · 클릭메이트 …)를 직접 입력
///  - SELLERBRICKS: 셀러브릭스에서 자체 송출 중인 방송을 연동(웹훅 · 피드)으로 받아 온다
model ExternalBroadcast {
  id           String    @id @default(cuid())
  source       String    @default("MANUAL") // MANUAL | SELLERBRICKS
  externalId   String? // 셀러브릭스 방송 ID (MANUAL 은 비움)
  title        String
  sellerName   String    @default("")
  platform     String    @default("ETC") // live-platforms 코드
  url          String // 시청 주소 (새 창으로 열기)
  embedUrl     String? // 끼워 넣을 수 있는 플레이어 주소 (허용 호스트만)
  hlsUrl       String? // HLS(.m3u8) 재생 주소 (셀러브릭스 자체 송출)
  thumbnailUrl String?
  status       String    @default("LIVE") // SCHEDULED | LIVE | ENDED
  startsAt     DateTime?
  endsAt       DateTime?
  isVisible    Boolean   @default(true) // 최고관리자가 메인에서 숨김
  sortOrder    Int       @default(0)
  lastSyncedAt DateTime? // 연동으로 마지막으로 받은 시각
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([status, isVisible])
}

/// 메인 영상 플레이어에 보여 줄 영상 (2026-11-14) — 최고관리자가 링크를 넣는다
///  - LIVE_COMMERCE: 지난 라이브 커머스 · 숏폼 영상
///  - CAMPAIGN: 홍보 · 캠페인 · 행사 영상
model HomeVideo {
  id           String    @id @default(cuid())
  category     String    @default("LIVE_COMMERCE") // LIVE_COMMERCE | CAMPAIGN
  title        String
  caption      String    @default("") // 셀러 · 브랜드 · 행사명 등 (제목 위 작은 글씨)
  url          String // 영상 주소 (유튜브 · 쇼츠 · 비메오 · mp4 등)
  thumbnailUrl String?
  duration     String    @default("") // 표시용 길이 (예: 0:30)
  isVisible    Boolean   @default(true)
  sortOrder    Int       @default(0)
  startsAt     DateTime? // 노출 기간 (선택)
  endsAt       DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category, isVisible, sortOrder])
}

/// 예약에 담은 브랜드 상품 (2026-11-14) — 셀러가 고른 위탁배송 상품을 예약한 공간에서 방송하려고 담는다.
///  예약이 승인되면 브랜드에 '방송 시연품' 요청(BrandRequest kind=DISPLAY)이 자동으로 가고, 공간으로 도착하면 운영자가 도착 확인한다.
///  준비 상태는 연결된 요청의 상태로 판단한다 (검토 중 · 발송 준비 · 배송 중 · 도착 · 불가)
model BookingBrandItem {
  id                   String        @id @default(cuid())
  bookingId            String
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  brandProductId       String
  brandProduct         BrandProduct  @relation(fields: [brandProductId], references: [id])
  sellerBrandProductId String?
  nameSnapshot         String
  supplyPriceSnapshot  Int           @default(0)
  optionLabel          String?
  quantity             Int           @default(1) // 시연품 수량
  brandRequestId       String?       @unique
  brandRequest         BrandRequest? @relation(fields: [brandRequestId], references: [id])
  dueAt                DateTime? // 도착 기한 (방송 2일 전)
  remindedAt           DateTime? // 도착 전날 미도착 알림 보낸 시각
  createdAt            DateTime      @default(now())

  @@unique([bookingId, brandProductId])
  @@index([brandProductId])
}

// 브랜드샵 화면(PC 왼쪽 플레이어)에 보여 줄 브랜드의 라이브 커머스 영상 — 브랜드 계정 '샵 꾸미기'에서 링크로 넣는다 (2026-11-14)
model BrandShopVideo {
  id           String    @id @default(cuid())
  shopId       String
  shop         BrandShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title        String
  caption      String    @default("")
  url          String
  thumbnailUrl String?
  duration     String    @default("")
  isVisible    Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shopId, isVisible, sortOrder])
}
