{
  "name": "seller-bricks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-db.mjs",
    "dev": "next dev -p 3007",
    "start": "next start -p 3007",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:start": "node scripts/ensure-db.mjs --db-only",
    "db:push": "prisma db push",
    "db:sync": "node scripts/ensure-db.mjs --force",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test:e2e": "node scripts/simulate-brand-flow.mjs",
    "test:e2e:izbeau": "node scripts/simulate-izbeau-features.mjs",
    "test:e2e:buyer": "node scripts/simulate-buyer-features.mjs",
    "test:e2e:storage": "node scripts/simulate-storage-ops.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.59.16",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35"
  }
}
