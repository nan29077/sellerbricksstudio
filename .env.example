# ---- Database ----
DATABASE_URL="postgresql://sellerbricks:sellerbricks@localhost:5434/sellerbricks?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3007"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# 코드에 고정된 데모 계정(admin@/manager@/facility@/seller@sellerbricks.kr) 로그인 허용 여부.
# 개발 환경에서는 기본 허용, 배포(production)에서는 기본 차단. 배포에서 시연이 필요할 때만 true.
DEMO_LOGIN=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3007"

# ---- Storage (S3 compatible) - optional. 없으면 업로드는 mock URL 반환 ----
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Payment PG - optional. 없으면 MockPaymentAdapter 동작 ----
PAYMENT_PROVIDER="mock"            # mock | toss | portone
TOSS_SECRET_KEY=""
TOSS_CLIENT_KEY=""
PORTONE_API_KEY=""
PORTONE_API_SECRET=""
PAYMENT_WEBHOOK_SECRET=""         # 웹훅 본문 HMAC-SHA256 서명 키. 배포 환경에서 비어 있으면 웹훅을 모두 거절

# ---- Catenoid Streaming - optional. 없으면 MockCatenoidAdapter 동작 ----
CATENOID_API_BASE=""
CATENOID_API_KEY=""
CATENOID_TENANT_ID=""

# ---- Kakao Alimtalk - optional. 없으면 MockKakaoAlimtalkAdapter 동작 ----
KAKAO_ALIMTALK_PROVIDER="mock"     # mock | solapi | ncp
KAKAO_API_KEY=""
KAKAO_API_SECRET=""
KAKAO_SENDER_KEY=""
KAKAO_PLUS_FRIEND_ID=""
CRON_SECRET=""   # 예약 자동 처리(/api/cron/bookings) 외부 스케줄러용 비밀값

# ---- 보안 · 운영 (2026-11) ----
ALLOW_MOCK_PAYMENT=""   # 배포 환경에서 Mock 결제를 허용(시연용). 실제 PG 연동 전에는 비워 두면 배포 환경 주문이 막힙니다
TRUSTED_PROXY_COUNT=""  # CloudFront·로드밸런서 뒤라면 프록시 단계 수(예: 1). 요청 횟수 제한에 쓰는 접속 IP 판별
IMAGE_HOSTS=""          # next/image 최적화를 허용할 외부 이미지 호스트(쉼표 구분)
S3_PUBLIC_URL=""        # 업로드 파일 공개 주소(예: CloudFront 도메인). 비우면 S3 주소
RESEND_API_KEY=""       # 메일 발송(비밀번호 재설정 · 이메일 인증). https://resend.com
MAIL_FROM=""            # 보내는 사람 예) "스토리지마켓 <no-reply@sellerbricks.co.kr>"
ALLOW_SEED=""           # 배포 환경에서 시드 실행 허용 (기본 차단)
