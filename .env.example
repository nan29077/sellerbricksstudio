# ---- Database ----
DATABASE_URL="postgresql://sellerbricks:sellerbricks@localhost:5432/sellerbricks?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Storage (S3 compatible) - optional. 없으면 업로드는 mock URL 반환 ----
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Payment PG - optional. 없으면 MockPaymentAdapter 동작 ----
PAYMENT_PROVIDER="mock"            # mock | toss | portone
TOSS_SECRET_KEY=""
TOSS_CLIENT_KEY=""
PORTONE_API_KEY=""
PORTONE_API_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# ---- Catenoid Streaming - optional. 없으면 MockCatenoidAdapter 동작 ----
CATENOID_API_BASE=""
CATENOID_API_KEY=""
CATENOID_TENANT_ID=""

# ---- Kakao Alimtalk - optional. 없으면 MockKakaoAlimtalkAdapter 동작 ----
KAKAO_ALIMTALK_PROVIDER="mock"     # mock | solapi | ncp
KAKAO_API_KEY=""
KAKAO_API_SECRET=""
KAKAO_SENDER_KEY=""
KAKAO_PLUS_FRIEND_ID=""
